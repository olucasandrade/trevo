{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@trevo/core": ["../../packages/core/src"],
      "@trevo/ui": ["../../packages/ui/src"],
      "@trevo/api-client": ["../../packages/api-client/src"],
      "@trevo/i18n": ["../../packages/i18n/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
