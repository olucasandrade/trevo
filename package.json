{
  "name": "trevo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@trevo/web",
    "dev:desktop": "turbo dev --filter=@trevo/desktop",
    "dev:landing": "turbo dev --filter=@trevo/landing",
    "build": "turbo build",
    "build:web": "turbo build --filter=@trevo/web",
    "build:desktop": "turbo build --filter=@trevo/desktop",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}
